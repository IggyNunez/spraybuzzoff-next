# GorillaDesk API — server-side only (no NEXT_PUBLIC_ prefix)
# Get your API key from GorillaDesk > Settings > API
GORILLADESK_API_KEY=
GORILLADESK_API_BASE=https://api.gorilladesk.com/v1

# Cloudflare Turnstile. The form check stays off until BOTH are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
